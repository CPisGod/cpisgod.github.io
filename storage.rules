rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // YOUR_UID 를 Firebase 콘솔 > Authentication > 사용자 의 UID 로 교체하세요.
    match /docs/{file} {
      allow read: if request.auth != null && request.auth.uid == 'YOUR_UID';
      allow write: if request.auth != null && request.auth.uid == 'YOUR_UID'
                   && (request.resource == null || request.resource.size < 50 * 1024 * 1024);
    }
  }
}
